func SetEdens(dst, umag *data.Slice) {
	data.Copy(dst, umag)
	//cuda.Zero(dst)
	AddEdens_demag(dst)
	AddExchangeEnergyDensity(dst)
	AddExchangeEnergyDensity(dst) // Non local
	AddAnisotropyEnergyDensity(dst)
	AddMagnetoelasticEnergyDensity(dst)
	AddCustomEnergyDensity(dst)
	AddEdens_zeeman(dst)
}

func SetUmag(dst *data.Slice) {
	cuda.Zero(dst)
	AddEdens_demag(dst)
}


//AddUexchangePlus(U, m,mold *data.Slice, Aex SymmLUT, Msat MSlice, regions *Bytes, mesh *data.Mesh) {
func AddExchangeEnergyDensityPlus(dst,mold *data.Slice) {
	ms := Msat.MSlice()
	defer ms.Recycle()
	cuda.AddUexchangePlus(dst, M.Buffer(),mold, lex2.Gpu(), ms, regions.Gpu(), M.Mesh())
}