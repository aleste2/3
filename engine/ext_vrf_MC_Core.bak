func MCGetU(dst, BeffMC,mold *data.Slice) {
	cuda.Zero(dst)
	AddExchangeEnergyDensity(dst)
	//AddExchangeEnergyDensityPlus(dst,mold)
	AddAnisotropyEnergyDensity(dst)
	AddMagnetoelasticEnergyDensity(dst)
	AddCustomEnergyDensity(dst)
	AddEdens_zeeman(dst)

	if EnableDemag == true {
		mf := ValueOf(M_full)
		defer cuda.Recycle(mf)
		factor := float32(-0.5)
		//cuda.Zero(dst)
		cuda.AddDotProduct(dst, factor, BeffMC, mf)
	}
}

func MCmove(mnew, x, y, z *data.Slice, iteration int) {
	cuda.MCmove(mnew, x, y, z, iteration, M.Mesh())
}

func MCCompare(unew, uold, mnew, mold, rnd *data.Slice, iteration int, changed *data.Slice) {

	temp := Temp.MSlice()
	defer temp.Recycle()

	cuda.MCCompare(unew, uold, mnew, mold, rnd, temp, iteration, M.Mesh(), changed,float32(Ncell))
}

func SetAngle(dst *data.Slice) {
	N := Mesh().NCell()
	if Xr.generator == 0 {
		Xr.generator = curand.CreateGenerator(curand.PSEUDO_DEFAULT)
		Xr.seed = 1
		Xr.randomumbers = cuda.Buffer(1, M.Buffer().Size())
	}
	//Xr.generator.GenerateNormal(uintptr(theta.randomumbers.DevPtr(0)), int64(N), 0, 1)
	Xr.generator.GenerateUniform(uintptr(Xr.randomumbers.DevPtr(0)), int64(N))

	if Yr.generator == 0 {
		Yr.generator = curand.CreateGenerator(curand.PSEUDO_DEFAULT)
		Yr.seed = 1
		Yr.randomumbers = cuda.Buffer(1, M.Buffer().Size())
	}
	//Yr.generator.GenerateNormal(uintptr(theta.randomumbers.DevPtr(0)), int64(N), 0, 1)
	Yr.generator.GenerateUniform(uintptr(Yr.randomumbers.DevPtr(0)), int64(N))

	if Zr.generator == 0 {
		Zr.generator = curand.CreateGenerator(curand.PSEUDO_DEFAULT)
		Zr.seed = 1
		Zr.randomumbers = cuda.Buffer(1, M.Buffer().Size())
	}
	//Xr.generator.GenerateNormal(uintptr(theta.randomumbers.DevPtr(0)), int64(N), 0, 1)
	Zr.generator.GenerateUniform(uintptr(Zr.randomumbers.DevPtr(0)), int64(N))

	//Xr.generator.GenerateNormal(uintptr(theta.randomumbers.DevPtr(0)), int64(N), 0, 1)
	Xr.generator.GenerateUniform(uintptr(Xr.randomumbers.DevPtr(0)), int64(N))

	data.Copy(dst, Xr.randomumbers)

}

